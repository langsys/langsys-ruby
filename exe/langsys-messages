#!/usr/bin/env ruby
# frozen_string_literal: true

# MSG-7: list, and with --register register, every server-message template an app declares.
#
#   langsys-messages [--register] [--strict] path/to/messages.rb ...
#
# Each file declares its sources:
#
#   Langsys::Messages.sources << Langsys::Messages::Source.new("Signup") do |catalog|
#     catalog.add("Email can't be blank", field: "email")
#   end
#
# A message that cannot be listed is reported with the source, the field and what would make it
# listable, and the command still exits 0: the first emission registers it. --strict exits 1 for
# one, for a team that wants no error shown untranslated even once. --register reads
# LANGSYS_API_KEY / LANGSYS_PROJECT_ID.
require "langsys"

register = ARGV.delete("--register")
strict = ARGV.delete("--strict")
abort "usage: langsys-messages [--register] [--strict] FILE..." if ARGV.empty?

ARGV.each { |file| load File.expand_path(file) }
client = register ? Langsys::Client.new : nil
exit Langsys::Messages::Command.run(sources: Langsys::Messages.sources, client: client, register: !register.nil?,
                                    strict: !strict.nil?)
