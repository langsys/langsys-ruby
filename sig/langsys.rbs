# Type signatures for the public API of the langsys gem.

module Langsys
  VERSION: String
  UNCATEGORIZED: String

  def self.new: (**untyped) -> Langsys::Client
  def self.canonicalize_locale: (String?) -> String
  def self.normalize_locale: (String?) -> String
  def self.parse_accept_language: (String?) -> Array[String]
  def self.detect_preferred_locale: (?String?, ?Array[String]?) -> String?

  module Locale
    def self.resolve_request_locale: (supported: Array[String], base: String, ?url: String?, ?cookie: String?, ?accept_language: String?) -> Hash[Symbol, untyped]
  end
  def self.interpolate: (String, Hash[untyped, untyped]?, ?String) -> String
  def self.icu?: (String) -> bool
  def self.generate_custom_id: (String?, Array[String]) -> String
  def self.canonical_block_json: (String?, Array[String]) -> String
  def self.normalize_category: (String?) -> String
  # Accepted on lookup, never emitted (CID-3). Most likely first, de-duplicated.
  def self.legacy_custom_ids: (String?, Array[String]) -> Array[String]

  # -- errors ---------------------------------------------------------------

  class Error < StandardError
  end

  class ConfigurationError < Error
  end

  class NetworkError < Error
  end

  class ApiError < Error
    attr_reader status_code: Integer?
    attr_reader response: untyped
    attr_reader request_id: String?
    attr_reader errors: untyped
    def initialize: (String, ?status_code: Integer?, ?response: untyped, ?request_id: String?, ?errors: untyped) -> void
  end

  class AuthenticationError < ApiError
  end

  class AuthorizationError < ApiError
  end

  class PaymentRequiredError < ApiError
  end

  class ValidationError < ApiError
  end

  class RateLimitError < ApiError
  end

  # -- reactive primitive ---------------------------------------------------

  class Signal[T]
    def initialize: (T) -> void
    def get: () -> T
    def set: (T) -> void
    def update: () { (T) -> T } -> void
    def subscribe: (?untyped) ?{ (T) -> void } -> Proc
  end

  # -- value objects --------------------------------------------------------

  class Country
    attr_accessor code: String
    attr_accessor label: String
    def initialize: (?code: String, ?label: String) -> void
  end

  class DialCode
    attr_accessor country_code: String
    attr_accessor dial_code: String
    attr_accessor name: String
    def initialize: (?country_code: String, ?dial_code: String, ?name: String) -> void
  end

  class Currency
    attr_accessor code: String
    attr_accessor name: String
    attr_accessor symbol: String
    attr_accessor symbol_native: String
    attr_accessor decimal_digits: Integer
    attr_accessor rounding: Float
    def initialize: (?code: String, ?name: String, ?symbol: String, ?symbol_native: String, ?decimal_digits: Integer, ?rounding: Float) -> void
  end

  class LocaleInfo
    attr_accessor code: String
    attr_accessor locale_name: String
    attr_accessor lang_name: String
    def initialize: (?code: String, ?locale_name: String, ?lang_name: String) -> void
  end

  class LocaleFlat
    attr_accessor code: String
    attr_accessor name: String
    def initialize: (?code: String, ?name: String) -> void
  end

  class Project
    attr_accessor id: String
    attr_accessor title: String
    attr_accessor base_locale: String
    attr_accessor target_locales: Array[String]
    attr_accessor default_locales: Hash[String, String]
    attr_accessor key_type: String
    attr_accessor batch_limit: Integer
    # nil when the server omitted the field — a pre-capability server (GATE-8).
    attr_accessor write_enabled: bool?
    attr_accessor raw: Hash[String, untyped]
    # Describes the KEY, not the session's capability. Capability is Client#can_write?.
    def write_key_type?: () -> bool
    def self.from_response: (Hash[String, untyped]) -> Project
  end

  # -- cache backends -------------------------------------------------------

  module Cache
    class Memory
      def get: (String) -> untyped
      def set: (String, untyped, ?Integer) -> void
      def delete: (String) -> void
      def clear: () -> void
    end

    class File
      def initialize: (?String?) -> void
      def get: (String) -> untyped
      def set: (String, untyped, ?Integer) -> void
      def delete: (String) -> void
      def clear: () -> void
    end

    class Null
      def get: (String) -> nil
      def set: (String, untyped, ?Integer) -> nil
      def delete: (String) -> nil
      def clear: () -> nil
    end
  end

  # -- client ---------------------------------------------------------------

  class Client
    def initialize: (?String?, ?String?, ?api_key: String?, ?project_id: String?, ?api_url: String?, ?base_locale: String?, ?locale: String?, ?locale_source: untyped, ?cache: untyped, ?cache_ttl: Integer?, ?timeout: Float?, ?auto_flush: bool, ?logger: untyped) -> void

    def authorize: (?force: bool) -> Project
    def project: () -> Project
    def key_type: () -> String
    def can_write?: (?refresh: bool) -> bool
    # REG-2: has the current burst settled?
    def flush_due?: () -> bool
    # REG-8: current backoff delay in seconds, nil when not backing off.
    def retry_delay: () -> Float?
    # GATE-5: true only once the server confirmed acceptance.
    def registered?: (String?, String) -> bool
    def flush_if_due: () -> Hash[String, untyped]
    # REG-3: best-effort end-of-context flush; never raises.
    def flush_on_shutdown: () -> Hash[String, untyped]
    def write_signal: () -> bool?
    def reset_write_decision!: () -> Client

    def locale: () -> String
    def set_locale: (String) -> void

    def get_translations: (?locale: String?, ?use_cache: bool) -> Hash[String, untyped]
    def translate: (String, ?category: String?, ?params: Hash[untyped, untyped]?, ?locale: String?, ?content_block_id: String?) -> String
    alias t translate

    def has_pending?: () -> bool
    def pending_phrases: () -> Array[Hash[String, String]]
    def pending_content_blocks: () -> Array[Hash[String, untyped]]
    def clear_pending: () -> void
    def flush_pending: (?refresh: bool) -> Hash[String, untyped]

    def register_phrases: (Array[untyped]) -> Array[untyped]
    def register_content_block: (String, Array[String], ?category: String?, ?custom_id: String?, ?label: String?) -> Hash[String, untyped]
    def sync: (Array[untyped], ?locale: String?) -> Hash[String, untyped]

    def translate_content_block: (String, ?category: String?) -> String
    def translate_page: (String, ?category: String?, ?selector_categories: Hash[String, untyped]?) -> String
    def get_translatable_attributes: () -> Array[String]
    def set_translatable_attributes: (Array[String]) -> Client
    def add_translatable_attributes: (Array[String]) -> Client
    def reset_translatable_attributes: () -> Client

    def effective_locale: (?String?) -> String
    # [custom_id, block, catalog_available] — the third element carries WIRE-4's
    # write-storm guard: a nil block during an outage is not evidence of absence.
    def lookup_block: (String, Array[String]) -> [ String, Hash[String, untyped]?, bool ]
    def queue_content_block: (String, String, String, Array[String]) -> untyped
    def lookup_phrase: (String, ?category: String?, ?params: Hash[untyped, untyped]?, ?locale: String?, ?record: bool) -> String
    def catalog_block: (String?, String, ?locale: String?) -> Hash[String, untyped]?
    def project_base_locale: () -> String?
    attr_reader messages_category: String
    def render_message: (Hash[untyped, untyped], ?locale: String?) -> String
    def emit_message: (code: String, template: String, ?params: Hash[untyped, untyped]?, ?field: String?) -> Hash[String, untyped]
    def message_template_known?: (String) -> bool
    def resolve_request_locale: (?url: String?, ?cookie: String?, ?accept_language: String?) -> Hash[Symbol, untyped]
    def begin_request_scope: () -> RequestScope
    def end_request_scope: (RequestScope?) -> nil
    def request_scope: [T] () { () -> T } -> T

    def countries: (?String?) -> Array[Country]
    def dial_codes: (?String?) -> Array[DialCode]
    def currencies: (?String?) -> Array[Currency]
    def country_name: (String, ?String?) -> String
    def currency_name: (String, ?String?) -> String
    def locales: (?String?) -> Hash[String, Array[LocaleFlat]]
    def locales_flat: (?String?) -> Array[LocaleFlat]
    def locales_data: (?String?) -> Array[LocaleInfo]
    def locale_name: (String, ?short: bool, ?in_locale: String?) -> String
    def detect_preferred_locale: (?String?, ?Array[String]?) -> String?

    def refresh: () -> bool
    def clear_cache: (?String?) -> void
    def close: () -> bool
  end

  # -- HTML tokenizer + page translator (TOK-1..4, MARK-1/2) ----------------

  module Html
    # TOK-2/TOK-4: Unicode-aware. Ruby's \s is ASCII-only and leaves U+00A0 and
    # U+2028/U+2029 in the token.
    WHITESPACE_CODE_POINTS: Array[Integer]
    WHITESPACE: Regexp
    PLACEHOLDER_ESCAPE: Regexp
    PHRASE_MARKERS: Array[String]
    CONTENT_BLOCK_MARKERS: Array[String]
    # TOK-1: excluded by element NAME, not by how the parser models the children.
    NON_TOKENIZED_ELEMENTS: Array[String]
    # TOK-3: twenty-seven, and the order is normative.
    DEFAULT_TRANSLATABLE_ATTRIBUTES: Array[String]

    def self.ensure_nokogiri!: () -> bool
    def self.normalize_whitespace: (String?) -> String
    def self.canonical_token: (String?) -> String
    def self.normalize_markup_placeholders: (String) -> String
    def self.whitespace_char?: (String?) -> bool
    def self.phrase_marked?: (untyped) -> bool
    def self.classify_block_attribute: (untyped) -> (:absent | :declaration | :opt_out | :identity)
    def self.excluded_from_tokenizing?: (String | Symbol) -> bool
    def self.extract_phrases: (String?, ?Array[String]?) -> Array[String]
    def self.apply_block_translations: (String?, Hash[String, untyped], ?Array[String]?) -> String
    def self.apply_element: (untyped, Hash[String, untyped], ?Array[String]?, ?include_self: bool) -> void
    def self.unit_tokens: (untyped, ?Array[String]?) -> [ Array[String], Integer ]
    def self.phrase_unit?: (Array[String], Integer) -> bool
    def self.own_tokens?: (untyped, ?Array[String]?) -> bool
    def self.marked_host?: (untyped) -> bool
    def self.marker_on?: (untyped, Array[String]) -> bool
    def self.translation_excluded?: (untyped) -> bool
    def self.resolved_scope?: (untyped) -> bool
    def self.block_identity: (untyped) -> String

    module Markup
      def self.encode: (untyped) -> [ String, Array[untyped] ]
      def self.token_params: (Integer) -> Hash[String, String]
      def self.render_into: (untyped, String, Array[untyped]) -> untyped
      def self.strip_sentinels: (String) -> String
    end
    def self.inner_html: (untyped) -> String
    def self.text_content: (untyped) -> String
    def self.parse_fragment: (String) -> untyped
    def self.skip?: (untyped) -> bool

    class Page
      SKIP_ELEMENTS: Set[String]
      BLOCK_ELEMENTS: Set[String]
      # MARK-2: both spellings accepted on read; writers emit data-ls-*.
      MARKER_PREFIXES: Array[String]

      def self.translate: (untyped, String?, ?String?, ?Hash[String, untyped]?) -> String
      def self.marker_attr: (untyped, String) -> String?
      def self.content_block_marked?: (untyped) -> bool
    end
  end

  # -- interpolation --------------------------------------------------------

  class RequestScope
    KEY: Symbol
    attr_reader previous: RequestScope?
    def initialize: (RequestScope?) -> void
    def ended?: () -> bool
    def end!: () -> self
    def self.fiber_storage?: () -> bool
    def self.current: () -> RequestScope?
    def self.current=: (RequestScope?) -> RequestScope?
    def self.begin: () -> RequestScope
    def self.end: (RequestScope?) -> nil
  end

  def self.begin_request_scope: () -> RequestScope
  def self.end_request_scope: (RequestScope?) -> nil
  def self.request_scope: [T] () { () -> T } -> T

  module Messages
    MARKER: Regexp
    CODE: Regexp
    CODES: Array[String]
    SIZE_CODES: Hash[Symbol, Array[String]]
    DEFAULT_CATEGORY: String
    def self.markers: (String?) -> Array[String]
    def self.fill: (String?, Hash[untyped, untyped]?) -> String
    def self.scalar?: (untyped) -> bool
    def self.entry: (code: String, template: String, ?params: Hash[untyped, untyped]?, ?field: String?) -> Hash[String, untyped]
    def self.from_text: (String) -> Hash[String, String]
    def self.size_code: (Symbol | String, Symbol | String) -> String
    def self.envelope: (Array[Hash[String, untyped]], ?message: String, ?code: String) -> Hash[String, untyped]
    def self.resolve: (untyped, ?key: String?, ?resolver: ^(untyped) -> untyped) -> Array[Hash[String, untyped]]
    def self.dig: (untyped, String) -> untyped
    def self.collect: (untyped, Array[Hash[String, untyped]]) -> Array[Hash[String, untyped]]
    def self.normalize: (untyped) -> Hash[String, untyped]?
    def self.sources: () -> Array[Source]

    class TemplateCatalog
      LABEL_MARKERS: Array[String]
      FRAMEWORK_PLACEHOLDER: Regexp
      BRACE: Regexp
      attr_reader templates: Array[String]
      attr_reader problems: Array[Hash[Symbol, untyped]]
      def initialize: () -> void
      def add: (String, ?source: String?, ?field: String?) -> self
      def issue_for: (String) -> [String, String]?
    end

    class Source
      attr_reader name: String
      def initialize: (String) { (untyped) -> void } -> void
      def collect: (TemplateCatalog) -> TemplateCatalog
    end

    module Command
      def self.run: (sources: Array[Source], ?client: Client?, ?register: bool, ?out: untyped) -> Integer
      def self.register_new: (Client, Array[String], untyped) -> void
    end
  end

  module Controls
    CODE_POINTS: Array[Integer]
    PATTERN: Regexp
    def self.strip: [T] (T) -> T
  end

  module Interpolate
    SIMPLE_SLOT: Regexp
    # TOK-5: %name% accepted as the escape for {name}.
    PERCENT_SLOT: Regexp
    SELECTORS: Array[String]

    def self.icu?: (String) -> bool
    def self.call: (String, Hash[untyped, untyped]?, ?String, ?logger: untyped?) -> String
    def self.simple: (String, Hash[untyped, untyped], String) -> String
  end

  # -- locale-aware formatting ----------------------------------------------

  module Cldr
    DATE_STYLES: Array[String]

    def self.format_value: (untyped, String?) -> String
    def self.format_number: (Numeric, String?) -> String
    def self.format_date: (untyped, String?, ?String) -> String
    def self.plural_category: (Numeric, String?, ordinal: bool) -> String
    def self.cldr_locale: (String?) -> Symbol
  end
end
