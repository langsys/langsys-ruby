# Type signatures for the public API of the langsys gem.

module Langsys
  VERSION: String
  UNCATEGORIZED: String

  def self.new: (**untyped) -> Langsys::Client
  def self.canonicalize_locale: (String?) -> String
  def self.normalize_locale: (String?) -> String
  def self.parse_accept_language: (String?) -> Array[String]
  def self.detect_preferred_locale: (?String?, ?Array[String]?) -> String?
  def self.interpolate: (String, Hash[untyped, untyped]?, ?String) -> String
  def self.icu?: (String) -> bool
  def self.generate_custom_id: (String?, Array[String]) -> String
  def self.canonical_block_json: (String?, Array[String]) -> String
  def self.normalize_category: (String?) -> String
  # Accepted on lookup, never emitted (CID-3). Most likely first, de-duplicated.
  def self.legacy_custom_ids: (String?, Array[String]) -> Array[String]

  # -- errors ---------------------------------------------------------------

  class Error < StandardError
  end

  class ConfigurationError < Error
  end

  class NetworkError < Error
  end

  class ApiError < Error
    attr_reader status_code: Integer?
    attr_reader response: untyped
    attr_reader request_id: String?
    attr_reader errors: untyped
    def initialize: (String, ?status_code: Integer?, ?response: untyped, ?request_id: String?, ?errors: untyped) -> void
  end

  class AuthenticationError < ApiError
  end

  class AuthorizationError < ApiError
  end

  class PaymentRequiredError < ApiError
  end

  class ValidationError < ApiError
  end

  class RateLimitError < ApiError
  end

  # -- reactive primitive ---------------------------------------------------

  class Signal[T]
    def initialize: (T) -> void
    def get: () -> T
    def set: (T) -> void
    def update: () { (T) -> T } -> void
    def subscribe: (?untyped) ?{ (T) -> void } -> Proc
  end

  # -- value objects --------------------------------------------------------

  class Country
    attr_accessor code: String
    attr_accessor label: String
    def initialize: (?code: String, ?label: String) -> void
  end

  class DialCode
    attr_accessor country_code: String
    attr_accessor dial_code: String
    attr_accessor name: String
    def initialize: (?country_code: String, ?dial_code: String, ?name: String) -> void
  end

  class Currency
    attr_accessor code: String
    attr_accessor name: String
    attr_accessor symbol: String
    attr_accessor symbol_native: String
    attr_accessor decimal_digits: Integer
    attr_accessor rounding: Float
    def initialize: (?code: String, ?name: String, ?symbol: String, ?symbol_native: String, ?decimal_digits: Integer, ?rounding: Float) -> void
  end

  class LocaleInfo
    attr_accessor code: String
    attr_accessor locale_name: String
    attr_accessor lang_name: String
    def initialize: (?code: String, ?locale_name: String, ?lang_name: String) -> void
  end

  class LocaleFlat
    attr_accessor code: String
    attr_accessor name: String
    def initialize: (?code: String, ?name: String) -> void
  end

  class Project
    attr_accessor id: String
    attr_accessor title: String
    attr_accessor base_locale: String
    attr_accessor target_locales: Array[String]
    attr_accessor default_locales: Hash[String, String]
    attr_accessor key_type: String
    attr_accessor batch_limit: Integer
    # nil when the server omitted the field — a pre-capability server (GATE-8).
    attr_accessor write_enabled: bool?
    attr_accessor raw: Hash[String, untyped]
    # Describes the KEY, not the session's capability. Capability is Client#can_write?.
    def write_key_type?: () -> bool
    def self.from_response: (Hash[String, untyped]) -> Project
  end

  # -- cache backends -------------------------------------------------------

  module Cache
    class Memory
      def get: (String) -> untyped
      def set: (String, untyped, ?Integer) -> void
      def delete: (String) -> void
      def clear: () -> void
    end

    class File
      def initialize: (?String?) -> void
      def get: (String) -> untyped
      def set: (String, untyped, ?Integer) -> void
      def delete: (String) -> void
      def clear: () -> void
    end

    class Null
      def get: (String) -> nil
      def set: (String, untyped, ?Integer) -> nil
      def delete: (String) -> nil
      def clear: () -> nil
    end
  end

  # -- client ---------------------------------------------------------------

  class Client
    def initialize: (?String?, ?String?, ?api_key: String?, ?project_id: String?, ?api_url: String?, ?base_locale: String?, ?locale: String?, ?locale_source: untyped, ?cache: untyped, ?cache_ttl: Integer?, ?timeout: Float?, ?auto_flush: bool, ?logger: untyped) -> void

    def authorize: (?force: bool) -> Project
    def project: () -> Project
    def key_type: () -> String
    def can_write?: (?refresh: bool) -> bool
    def write_signal: () -> bool?
    def reset_write_decision!: () -> Client

    def locale: () -> String
    def set_locale: (String) -> void

    def get_translations: (?locale: String?, ?use_cache: bool) -> Hash[String, untyped]
    def translate: (String, ?category: String?, ?params: Hash[untyped, untyped]?, ?locale: String?, ?content_block_id: String?) -> String
    alias t translate

    def has_pending?: () -> bool
    def pending_phrases: () -> Array[Hash[String, String]]
    def pending_content_blocks: () -> Array[Hash[String, untyped]]
    def clear_pending: () -> void
    def flush_pending: () -> Hash[String, untyped]

    def register_phrases: (Array[untyped]) -> Array[untyped]
    def register_content_block: (String, Array[String], ?category: String?, ?custom_id: String?, ?label: String?) -> Hash[String, untyped]
    def sync: (Array[untyped], ?locale: String?) -> Hash[String, untyped]

    def translate_content_block: (String, ?category: String?) -> String
    def translate_page: (String, ?category: String?, ?selector_categories: Hash[String, untyped]?) -> String
    def get_translatable_attributes: () -> Array[String]
    def set_translatable_attributes: (Array[String]) -> Client
    def add_translatable_attributes: (Array[String]) -> Client
    def reset_translatable_attributes: () -> Client

    def effective_locale: (?String?) -> String
    # [custom_id, block, catalog_available] — the third element carries WIRE-4's
    # write-storm guard: a nil block during an outage is not evidence of absence.
    def lookup_block: (String, Array[String]) -> [ String, Hash[String, untyped]?, bool ]
    def queue_content_block: (String, String, String, Array[String]) -> untyped

    def countries: (?String?) -> Array[Country]
    def dial_codes: (?String?) -> Array[DialCode]
    def currencies: (?String?) -> Array[Currency]
    def country_name: (String, ?String?) -> String
    def currency_name: (String, ?String?) -> String
    def locales: (?String?) -> Hash[String, Array[LocaleFlat]]
    def locales_flat: (?String?) -> Array[LocaleFlat]
    def locales_data: (?String?) -> Array[LocaleInfo]
    def locale_name: (String, ?short: bool, ?in_locale: String?) -> String
    def detect_preferred_locale: (?String?, ?Array[String]?) -> String?

    def refresh: () -> bool
    def clear_cache: (?String?) -> void
    def close: () -> bool
  end
end
